# Copy to .env and adjust as needed. docker-compose.yml sets these per-service;
# this file documents the full env surface for running cmd/server directly.
# See internal/config/config.go for defaults.

# "replay" or "gateway"
ROLE=gateway

REDIS_URL=redis://localhost:6379

# Identifies this process's lane (e.g. replay, live, compare-monza-2024)
SESSION_KEY=demo

# Replay role only: path to the .jsonl clip to loop
CLIP_FILE=data/replays/monza-2024-race.jsonl

# Replay role only: playback speed multiplier (<=0 defaults to 1)
SPEED=1

# Gateway role only: listen address
ADDR=:8080

# Replay role only: set to any non-empty value to derive loop position from the
# wall clock instead of restarting each loop from zero (used by the compare lanes)
PHASE_WALLCLOCK=

# Gateway role only: comma-separated WebSocket origin allowlist.
# Defaults to localhost:*,127.0.0.1:* — set to your served host in production.
ALLOWED_ORIGINS=

# Gateway role only: comma-separated /ws?session=<key> registry allowlist (bounds how many
# per-session hubs a client can spawn). Empty = the built-in compare lanes
# (compare-monza-2023, compare-monza-2024). Set this when adding other circuits/years.
ALLOWED_SESSIONS=
